{
  "name": "contractoros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "worker": "tsx --tsconfig tsconfig.json workers/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/db-seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:sync": "tsx --env-file=.env scripts/db-sync.ts",
    "db:seed:masters": "tsx --env-file=.env scripts/seed-masters.ts",
    "db:seed:users": "tsx --env-file=.env scripts/seed-users.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.5.1",
    "formik": "^2.4.9",
    "ioredis": "^6.0.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sequelize": "^6.37.8",
    "server-only": "^0.0.1",
    "yup": "^1.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
